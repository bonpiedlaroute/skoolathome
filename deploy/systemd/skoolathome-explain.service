# « Je n'ai pas compris » (T29): explain what the tablet asked, while the computer is on.
# Run every few minutes by skoolathome-explain.timer. One NIP-98 signature when nothing waits.
# Edit WorkingDirectory to your clone, like skoolathome-evening.service.
[Unit]
Description=skoolathome explanations (« Je n'ai pas compris »)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/boulot/dev/skoolathome
ExecStart=%h/.local/bin/uv run --frozen skoolathome explain
TimeoutStartSec=30min
Nice=5
