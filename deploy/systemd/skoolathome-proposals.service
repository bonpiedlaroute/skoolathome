# The graph of proposals (T28): once a week, the teachers' habits seen in the data become rules
# for the parent to authorize. No model: a few seconds. Edit WorkingDirectory to your clone.
[Unit]
Description=skoolathome rule proposals
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/boulot/dev/skoolathome
ExecStart=%h/.local/bin/uv run --frozen skoolathome proposals run
